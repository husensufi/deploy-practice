# Copy this file to .env in the project root and replace placeholder values.
# Backend-local backend/.env values and process environment variables take
# precedence over values in this file.

ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# Keep this pointed at the existing persistent SQLite database.
DATABASE_URL=sqlite:///./pcos_gynocare.db

# Generate a private random value before using this app outside local development.
SECRET_KEY=replace_with_a_long_random_secret

# Optional initial Admin account. Change both values before first startup.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# Optional Azure OpenAI configuration. Leave blank to run without AI features.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Do not put secrets in VITE_* variables; frontend variables are public.