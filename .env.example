# Copy this file to a new file named exactly ".env" (same folder as main.py).
# Then replace the text below with your real key from https://console.anthropic.com
#
# NEVER share your real .env file or upload it anywhere public (like GitHub) —
# anyone with this key can use your account.

AZURE_OPENAI_ENDPOINT="https://<your-resource-name>.cognitiveservices.azure.com/"
AZURE_OPENAI_API_KEY="<your-api-key>"
AZURE_OPENAI_DEPLOYMENT="<your-deployment-name>"
AZURE_OPENAI_MODEL="<your-model-name>"
AZURE_OPENAI_API_VERSION="<your-api-version>"